# Copie para ".env" (nesta pasta servidor/, ao lado do docker-compose.yml) e
# preencha. O ".env" NUNCA vai para o git nem para o zip.

# String de ligação do MongoDB Atlas (Database -> Connect -> Drivers).
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxxxx.mongodb.net/
MONGODB_DB=jogo

# Portas: HTTP (Express) e UDP (ENet).
HTTP_PORT=3000
ENET_PORT=7777

# Horas que um login vale.
SESSION_HOURS=72
# Segundos sem sinal do jogo até a conta deixar de contar como online
# (uma conta só pode estar aberta num lugar; ver README "Uma conta, um lugar").
PRESENCE_SECONDS=30

# Modo de testes: 1 = F6/F7 dão/tiram almas e F8 dá um balde de água (o
# servidor aceita); 0 = desligado. Sem esta linha vale "testes" do economia.json.
MODO_TESTES=0
